APP_ENV=development
DATABASE_URL=
SUPABASE_URL=
SUPABASE_KEY=
# Optional override; defaults to {SUPABASE_URL}/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=
BACKEND_BASE_URL=http://127.0.0.1:8000
FRONTEND_ORIGIN=http://127.0.0.1:5173

# AI Inference (Configured for Groq)
INFERENCE_PROVIDER=openai_compatible
INFERENCE_BASE_URL=https://api.groq.com/openai/v1
INFERENCE_API_KEY=
INFERENCE_MODEL=gpt-oss-120b

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

X_CLIENT_ID=
X_CLIENT_SECRET=
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
X_REFRESH_TOKEN_ENCRYPTION_KEY=

# Frontend env vars belong in frontend/.env.local, not here.
